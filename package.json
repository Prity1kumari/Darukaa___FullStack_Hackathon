{
  "name": "darukaa-earth",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade full-stack geospatial carbon and biodiversity analytics platform",
  "scripts": {
    "prepare": "husky install",
    "lint:frontend": "npm run --prefix frontend lint",
    "lint:backend": "cd backend && ruff check .",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "test:frontend": "npm run --prefix frontend test:run",
    "test:backend": "cd backend && pytest",
    "build:frontend": "npm run --prefix frontend build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "frontend/src/**/*.{ts,tsx,js,jsx}": [
      "npm run --prefix frontend lint",
      "prettier --write"
    ],
    "backend/**/*.py": [
      "ruff check --fix",
      "black"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
