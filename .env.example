# ==========================================
# Darukaa.Earth - Global Environment Config
# ==========================================

# Environment Mode: development, staging, production, test
ENVIRONMENT=development

# Postgres / PostGIS Database Configuration
POSTGRES_USER=darukaa_user
POSTGRES_PASSWORD=darukaa_secure_password
POSTGRES_DB=darukaa_earth
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://darukaa_user:darukaa_secure_password@postgres:5432/darukaa_earth

# Security & JWT Tokens
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
